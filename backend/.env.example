# Configuración del backend — copia este archivo a `.env` y rellena los valores.
#
# ⚠️  NUNCA subas el archivo `.env` real al repositorio ni lo compartas en el chat.
#     La SERVICE_ROLE_KEY solo debe vivir en el backend: NO exponerla al frontend.

# --- Supabase (PostgreSQL) ---
# Obtén estos valores en: Supabase Dashboard -> Settings -> API keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La SERVICE_ROLE_KEY ignora las políticas RLS. Úsala SOLO en el backend.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket de storage para logos (se crea automáticamente la primera vez)
SUPABASE_STORAGE_BUCKET=logos

# --- Autenticación JWT ---
# Genera un secreto largo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- General ---
# URL base del frontend (para CORS). En desarrollo local:
FRONTEND_URL=http://localhost:5173
PORT=3000
